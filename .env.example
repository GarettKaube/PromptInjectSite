OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-with-your-password
KUBERNETES_NAMESPACE=default
INJECTION_MAX_ACTIVE_PODS=6

# Uncomment and set this if kubectl uses a non-default kubeconfig path.
# KUBECONFIG=C:/Users/your-user/.kube/config

OPENCODE_POD_IMAGE=opencode-ollama-pi-env:v2
OPENCODE_POD_SECRET_NAME=opencode-auth
OPENCODE_POD_SECRET_KEY=OPENCODE_SERVER_PASSWORD

BACKEND_URL=your-backend-url

DB_USER=postgres
DB_PASSWORD="your-password"
DB_HOST=your-db-ip
DB_PORT=your-db-port
DB_NAME=your-db-name